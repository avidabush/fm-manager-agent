<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Manager Agent — BepInEx 6 (IL2CPP) plugin for Football Manager 26 (and FM27 once it ships).

    Build:   dotnet build -c Release
    Custom game folder:
             dotnet build -c Release -p:GameDir="D:\SteamLibrary\steamapps\common\Football Manager 26"

    The game must have been launched once with BepInEx installed, so BepInEx\interop exists.
    For FM27, point GameDir at the FM27 folder and rebuild.
  -->

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>ManagerAgent</AssemblyName>
    <RootNamespace>ManagerAgent</RootNamespace>
    <Version>0.3.4</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS0649;CS8618;NU1701</NoWarn>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>

    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Football Manager 26</GameDir>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
    <BepInExInterop>$(GameDir)\BepInEx\interop</BepInExInterop>
    <PluginOutDir>$(GameDir)\BepInEx\plugins\ManagerAgent</PluginOutDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- The installer and tests are separate programs. -->
    <Compile Remove="installer/**" />
    <Compile Remove="tests/**" />
    <Compile Remove="prebuild/**" />
  </ItemGroup>

  <ItemGroup Label="BepInEx core (ships with BepInEx)">
    <Reference Include="BepInEx.Core"><HintPath>$(BepInExCore)\BepInEx.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Unity.IL2CPP"><HintPath>$(BepInExCore)\BepInEx.Unity.IL2CPP.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Unity.Common"><HintPath>$(BepInExCore)\BepInEx.Unity.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(BepInExCore)\Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Common"><HintPath>$(BepInExCore)\Il2CppInterop.Common.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!--
    Game interop assemblies, generated by BepInEx on first launch.
    All of them are referenced so Unity types resolve regardless of which module they live in.
    The plugin never references FM/SI game types at compile time (it finds them by reflection
    at runtime), so a renamed FM class in a future patch can't break the build.
  -->
  <ItemGroup Label="Game interop (generated by BepInEx)">
    <Reference Include="$(BepInExInterop)\*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckGameDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(BepInExInterop)\UnityEngine.UIElementsModule.dll')"
           Text="BepInEx interop assemblies not found in '$(BepInExInterop)'. Install BepInEx 6 (IL2CPP) into the game folder, launch the game once to the main menu, then build again. If the game is elsewhere use: dotnet build -c Release -p:GameDir=&quot;X:\path\to\Football Manager 26&quot;" />
  </Target>

  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="Exists('$(GameDir)\BepInEx\plugins')">
    <MakeDir Directories="$(PluginOutDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginOutDir)" SkipUnchangedFiles="true" />
    <Message Importance="High" Text="Manager Agent copied to $(PluginOutDir)" />
  </Target>

</Project>
