<Project Sdk="Microsoft.NET.Sdk">
  <!-- Logic tests for ManagerAgent-Setup.exe. Run on Linux with: mono bin/SetupTests.exe -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(FrameworkPathOverride)' != ''">
    <EnableFrameworkPathOverride>true</EnableFrameworkPathOverride>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../installer/*.cs" Exclude="../installer/Program.cs" />
    <Compile Include="SetupTests.cs" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.IO.Compression" />
    <EmbeddedResource Include="../.build/plugin/ManagerAgent.dll" LogicalName="ManagerAgent.dll" />
  </ItemGroup>
</Project>
